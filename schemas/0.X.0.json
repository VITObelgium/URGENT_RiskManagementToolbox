{
  "$defs": {
    "Boundaries": {
      "additionalProperties": false,
      "properties": {
        "lb": {
          "title": "Lb",
          "type": "number"
        },
        "ub": {
          "title": "Ub",
          "type": "number"
        }
      },
      "required": [
        "lb",
        "ub"
      ],
      "title": "Boundaries",
      "type": "object"
    },
    "DomainServiceItem": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "initial_state": {
          "title": "Initial State",
          "type": "object"
        },
        "parameter_bounds": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParameterBoundaries"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "initial_state"
      ],
      "title": "DomainServiceItem",
      "type": "object"
    },
    "DomainServiceName": {
      "type": "string"
    },
    "LinearInequalities": {
      "additionalProperties": false,
      "properties": {
        "A": {
          "items": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object"
          },
          "minItems": 1,
          "title": "A",
          "type": "array"
        },
        "b": {
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "title": "B",
          "type": "array"
        },
        "sense": {
          "items": {
            "enum": [
              "<=",
              ">=",
              "<",
              ">"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Sense",
          "type": "array"
        }
      },
      "required": [
        "A",
        "b",
        "sense"
      ],
      "title": "LinearInequalities",
      "type": "object"
    },
    "ObjectiveFnName": {
      "type": "string"
    },
    "OptimizationParameters": {
      "additionalProperties": false,
      "properties": {
        "objectives": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/OptimizationStrategy"
              },
              "propertyNames": {
                "$ref": "#/$defs/ObjectiveFnName"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Objectives"
        },
        "max_generations": {
          "default": 10,
          "exclusiveMinimum": 0,
          "minimum": 1,
          "title": "Max Generations",
          "type": "integer"
        },
        "population_size": {
          "default": 10,
          "exclusiveMinimum": 0,
          "maximum": 200,
          "minimum": 2,
          "title": "Population Size",
          "type": "integer"
        },
        "max_stall_generations": {
          "default": 10,
          "exclusiveMinimum": 0,
          "minimum": 1,
          "title": "Max Stall Generations",
          "type": "integer"
        },
        "linear_inequalities": {
          "anyOf": [
            {
              "$ref": "#/$defs/LinearInequalities"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "title": "OptimizationParameters",
      "type": "object"
    },
    "OptimizationStrategy": {
      "enum": [
        "minimize",
        "maximize"
      ],
      "title": "OptimizationStrategy",
      "type": "string"
    },
    "ParameterBoundaries": {
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/Boundaries"
          },
          {
            "$ref": "#/$defs/ParameterBoundaries"
          }
        ]
      },
      "propertyNames": {
        "$ref": "#/$defs/VariableName"
      },
      "type": "object"
    },
    "PluginConfig": {
      "additionalProperties": false,
      "properties": {
        "connector": {
          "title": "Connector",
          "type": "string"
        },
        "optimizer": {
          "title": "Optimizer",
          "type": "string"
        },
        "domain_services": {
          "items": {
            "$ref": "#/$defs/DomainServiceName"
          },
          "minItems": 1,
          "title": "Domain Services",
          "type": "array"
        }
      },
      "required": [
        "connector",
        "optimizer",
        "domain_services"
      ],
      "title": "PluginConfig",
      "type": "object"
    },
    "RunMode": {
      "enum": [
        "evaluation",
        "optimization"
      ],
      "title": "RunMode",
      "type": "string"
    },
    "SimulationConfig": {
      "additionalProperties": false,
      "properties": {
        "server_job_timeout_seconds": {
          "default": 3600,
          "exclusiveMinimum": 0,
          "title": "Server Job Timeout Seconds",
          "type": "integer"
        },
        "worker_simulation_timeout_seconds": {
          "default": 900,
          "exclusiveMinimum": 0,
          "title": "Worker Simulation Timeout Seconds",
          "type": "integer"
        },
        "worker_count": {
          "default": 4,
          "exclusiveMinimum": 0,
          "minimum": 1,
          "title": "Worker Count",
          "type": "integer"
        },
        "checkpoint_interval": {
          "default": 5,
          "exclusiveMinimum": 0,
          "minimum": 1,
          "title": "Checkpoint Interval",
          "type": "integer"
        },
        "checkpoint_path": {
          "default": "/home/octopus/Projects/URGENT_RiskManagementToolbox/checkpoints",
          "format": "directory-path",
          "title": "Checkpoint Path",
          "type": "string"
        }
      },
      "title": "SimulationConfig",
      "type": "object"
    },
    "VariableName": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_mode": {
      "$ref": "#/$defs/RunMode",
      "default": "optimization"
    },
    "domain_services": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/DomainServiceItem"
        },
        "type": "array"
      },
      "propertyNames": {
        "$ref": "#/$defs/DomainServiceName"
      },
      "title": "Domain Services",
      "type": "object"
    },
    "optimization_parameters": {
      "$ref": "#/$defs/OptimizationParameters"
    },
    "worker_simulation_timeout_seconds": {
      "default": 900,
      "title": "Worker Simulation Timeout Seconds",
      "type": "integer"
    },
    "simulation_config": {
      "$ref": "#/$defs/SimulationConfig"
    },
    "plugins": {
      "$ref": "#/$defs/PluginConfig"
    }
  },
  "required": [
    "domain_services",
    "plugins"
  ],
  "title": "ProblemDispatcherDefinition",
  "type": "object"
}
